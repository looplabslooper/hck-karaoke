# dependencias / build
node_modules/
dist/
.turbo/
*.tsbuildinfo

# entorno
.env
.env.local

# contenido pesado / referencia (no se versiona)
/old/
/repertorio/
library/**/*.mp3
library/**/*.wav
library/**/*.opus
# Letras de canciones importadas de carpetas externas (catálogos de terceros,
# pueden ser miles). Las letras de canciones *propias* sí se versionan, y por
# eso viven en library/<id>/ y no acá — ver CLAUDE.md.
library/_imported/

# base de datos local (se recrea con migraciones + seed)
/data/

# entorno Python del pipeline de sincronización (se recrea con `uv sync`)
pipeline/.venv/
pipeline/test-*.json
pipeline/test-*.wav
pipeline/test-*.txt

# editores / sistema
.DS_Store
Thumbs.db
