# dependencias / build
node_modules/
dist/
.turbo/
*.tsbuildinfo

# entorno
.env
.env.local

# contenido pesado / referencia (no se versiona)
/old/
/repertorio/
# Carpeta de paso para archivos que el operador acerca a mano (ej. imágenes
# pegadas en el chat que Claude no puede leer directo) — se procesan y se
# mueven/borran, no vive nada acá de forma permanente.
/_incoming-assets/
library/**/*.mp3
library/**/*.wav
library/**/*.opus
# Letras de canciones importadas de carpetas externas (catálogos de terceros,
# pueden ser miles). Las letras de canciones *propias* sí se versionan, y por
# eso viven en library/<id>/ y no acá — ver CLAUDE.md.
library/_imported/
# Fotos de cantantes de la sesión activa — efímeras, se borran al terminar la
# sesión (ver apps/server/src/index.ts, POST /api/sessions/end).
library/_sessions/
# Banners subidos a mano para el carrusel de Inicio (ver PROMPTS-BANNERS.md).
library/_banners/
# Portadas subidas a mano para las categorías de Inicio (una por CategoryId).
library/_categories/

# pack de templates para la animación de cara en el escenario (video.mp4 +
# transform.json por carpeta) — el operador la puebla a mano, ver
# .claude/agents/director-escenas.md
/templates/

# base de datos local (se recrea con migraciones + seed)
/data/

# entorno Python del pipeline de sincronización (se recrea con `uv sync`)
pipeline/.venv/
pipeline/test-*.json
pipeline/test-*.wav
pipeline/test-*.txt
# modelo de MediaPipe para track_face.py (~3.6MB, se re-descarga con curl, ver track_face.py)
pipeline/models/
pipeline/__pycache__/

# exports del design tool (Claude Design) y assets de referencia sueltos —
# insumo para construir pantallas, no se versionan (ver design-style-a.md
# para lo que sí es referencia durable).
/High Class Karaoke Redesign/
/High Class Karaoke Redesign.zip
/library/version 3 w feat/
/Prompt_texto_principal_ (1).mp4
/Starting_from_this_exact_frame (1).mp4

# editores / sistema
.DS_Store
Thumbs.db
scripts/_backups/
